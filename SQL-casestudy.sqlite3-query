--Q2
--1
SELECT COUNT(ProductID),
CASE WHEN ListPrice < 1000 THEN 'Under 1000'
WHEN ListPrice BETWEEN 1000 AND 2000 THEN 'Btwn 1000 and 2000'
ELSE 'Above 2000'
END AS Category
FROM Product
GROUP BY Category;

-- We did 0-1000, 1000-2000, 2000+ in order to have 3 categories (easy number to visualize)
-- Product category would be helpful, as the category could influence the weight of spending the same amounnt of money


SELECT SalesOrderID
FROM SalesOrderDetail
GROUP BY SalesOrderID
ORDER BY SalesOrderID;

SELECT SalesOrderID
FROM SalesOrderHeader
GROUP BY SalesOrderID
ORDER BY SalesOrderID;

SELECT c.FirstName || ' ' || LastName AS FullName
FROM Customer AS c
WHERE c.CustomerID IN (
    SELECT s.CustomerID
    FROM SalesOrderHeader AS s
) ;

SELECT c.FirstName || ' ' || LastName AS FullName
FROM Customer AS c
WHERE c.CustomerID IN (
    SELECT s.CustomerID
    FROM SalesOrderHeader AS s
) AND c.CustomerID > 20000;


SELECT
    CASE
        WHEN c.CompanyName != "" THEN 1
        ELSE 0
    END AS Company,
    AVG(s.SubTotal),
    COUNT(c.CustomerID)
FROM Customer AS c
JOIN SalesOrderHeader AS s
    ON s.CustomerID = c.CustomerID
GROUP BY Company
;

