--Product Questions
--Q1
--1
SELECT pc.name, 
MAX(p.ListPrice) AS 'Most Expensive Product', 
MIN(p.ListPrice) AS 'Least Expensive Product', 
MAX(p.ListPrice) - MIN(p.ListPrice) AS 'Range of Price',
COUNT(p.ProductModelID) AS 'Number of Products'
FROM Product as p
LEFT JOIN ProductCategory as pc
ON p.ProductCategoryID = pc.ProductCategoryID
GROUP BY pc.ParentProductCategoryID;

--2
SELECT pc.name, 
MAX(p.ListPrice) AS 'Most Expensive Product', 
MIN(p.ListPrice) AS 'Least Expensive Product', 
MAX(p.ListPrice) - MIN(p.ListPrice) AS 'Range of Price',
COUNT(p.ProductModelID) AS 'Number of Products'
FROM Product as p
LEFT JOIN ProductCategory as pc
ON p.ProductCategoryID = pc.ProductCategoryID
GROUP BY pc.ProductCategoryID
ORDER BY pc.ParentProductCategoryID, pc.ProductCategoryID
;
