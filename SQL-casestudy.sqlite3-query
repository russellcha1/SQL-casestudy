--         p.Name,
--         (p.ListPrice - sod.UnitPrice) AS price_difference
SELECT *
FROM Product            AS p
JOIN SalesOrderDetail   AS sod
    ON p.ProductID = sod.ProductID
;


--Q2


SELECT (ROUND(AVG((p.ListPrice - p.StandardCost)/p.ListPrice),2)*100) AS "Profit Margin",
    pc2.Name
FROM ProductCategory AS pc
JOIN ProductCategory AS pc2
    ON pc.ParentProductCategoryID = pc2.ProductCategoryID
JOIN Product AS p
    ON p.ProductCategoryID = pc.ProductCategoryID
GROUP BY pc2.Name;


--Q3
SELECT pc.Name, 
        pc.ProductCategoryID, 
        (SELECT(ROUND(AVG((p.ListPrice - p.StandardCost)/p.ListPrice),2)*100)
            FROM ProductCategory
            GROUP BY ParentProductCategoryID) AS "Profit Margin"
FROM Product            AS p
JOIN ProductCategory    AS pc
    ON p.ProductCategoryID = pc.ProductCategoryID
GROUP BY pc.ProductCategoryID
ORDER BY "Profit Margin" DESC
;



